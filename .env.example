# Server secret. Never commit a real key.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.2, the model named in the previous privacy policy.
OPENAI_MODEL=gpt-5.2

# Set to true only for local demos. Do not enable on the public site.
ARTIORE_MOCK=

# Optional fallback when OPENAI_API_KEY is unset. The function forwards
# { question, mode } to this origin's /api/artiore/analyze.
# Example: https://artiore.com
ARTIORE_UPSTREAM_URL=

# Baked into the static pages at build time. Default posts to this site's function.
# The live artiore.com endpoint does not send CORS headers, so a browser on another
# origin cannot call it directly. Prefer ARTIORE_UPSTREAM_URL for that fallback.
PUBLIC_ANALYZE_URL=/api/artiore/analyze
