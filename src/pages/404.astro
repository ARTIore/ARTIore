---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — ARTIore" description="That page is not on ARTIore." path="/404" noindex={true}>
  <section class="hero">
    <p class="eyebrow">404</p>
    <h1>This page is not here.</h1>
    <p class="lede">The address may be mistyped, or the page was never part of this site.</p>
    <div class="actions">
      <a class="button primary" href="/">Home</a>
      <a class="button ghost" href="/try">Try ARTIore</a>
    </div>
  </section>
</Base>
